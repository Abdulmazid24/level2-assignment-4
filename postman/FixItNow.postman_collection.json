{
  "info": {
    "name": "FixItNow API",
    "description": "Home services marketplace API. Set the collection variable `baseUrl` to http://localhost:3000 or the deployed URL. Run the three login requests in Auth first — they store each role's access token automatically, and the rest of the collection depends on that.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://level2-assignment-4-eta.vercel.app" },
    { "key": "customerToken", "value": "" },
    { "key": "technicianToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "technicianId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ayesha Siddiqua\",\n  \"email\": \"ayesha@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"+8801799999999\",\n  \"role\": \"CUSTOMER\"\n}"
            }
          }
        },
        {
          "name": "Register technician",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kamal Uddin\",\n  \"email\": \"kamal@fixitnow.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"TECHNICIAN\"\n}"
            }
          }
        },
        {
          "name": "Register with ADMIN role (rejected)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Not An Admin\",\n  \"email\": \"sneaky@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "description": "Returns 400. ADMIN is not self-assignable at registration."
          }
        },
        {
          "name": "Login customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('customerToken', pm.response.json().data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nusrat@example.com\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Login technician",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('technicianToken', pm.response.json().data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rafiqul@fixitnow.com\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('adminToken', pm.response.json().data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fixitnow.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Login with wrong password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nusrat@example.com\",\n  \"password\": \"wrong-password\"\n}"
            },
            "description": "Returns 401 with the same message as an unknown email, so the response cannot be used to discover which accounts exist."
          }
        },
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Get me without token",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Returns 401."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const users = pm.response.json().data.users;",
                  "const target = users && users.find((u) => u.role !== 'ADMIN');",
                  "if (target) {",
                  "    pm.collectionVariables.set('userId', target.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "List users as customer (rejected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] },
            "description": "Returns 403 — user management is admin-only."
          }
        },
        {
          "name": "Filter users by role (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?role=TECHNICIAN&status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [
                { "key": "role", "value": "TECHNICIAN" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
        },
        {
          "name": "Ban user (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users", "{{userId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"BANNED\"\n}" }
          }
        },
        {
          "name": "Reinstate user (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users", "{{userId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const categories = pm.response.json().data.categories;",
                  "if (categories && categories.length) {",
                  "    pm.collectionVariables.set('categoryId', categories[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          }
        },
        {
          "name": "Create category (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/categories", "host": ["{{baseUrl}}"], "path": ["api", "admin", "categories"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carpentry\",\n  \"description\": \"Furniture repair and fitting\"\n}"
            }
          }
        },
        {
          "name": "Create duplicate category (rejected)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/categories", "host": ["{{baseUrl}}"], "path": ["api", "admin", "categories"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Plumbing\"\n}" },
            "description": "Returns 409 from the unique constraint on category name."
          }
        },
        {
          "name": "Update category (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "categories", "{{categoryId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated description\"\n}" }
          }
        },
        {
          "name": "Delete category (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "categories", "{{categoryId}}"] },
            "description": "Returns 409 while any service still references this category."
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "List services",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const services = pm.response.json().data.services;",
                  "if (services && services.length) {",
                  "    pm.collectionVariables.set('serviceId', services[0].id);",
                  "    pm.collectionVariables.set('technicianId', services[0].technician.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/services", "host": ["{{baseUrl}}"], "path": ["api", "services"] }
          }
        },
        {
          "name": "Filter services",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const services = pm.response.json().data.services;",
                  "if (services && services.length) {",
                  "    pm.collectionVariables.set('serviceId', services[0].id);",
                  "    pm.collectionVariables.set('technicianId', services[0].technician.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services?category=Plumbing&location=Dhaka&minPrice=50&maxPrice=200&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"],
              "query": [
                { "key": "category", "value": "Plumbing" },
                { "key": "location", "value": "Dhaka" },
                { "key": "minPrice", "value": "50" },
                { "key": "maxPrice", "value": "200" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search services",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services?search=leak&minRating=4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"],
              "query": [
                { "key": "search", "value": "leak" },
                { "key": "minRating", "value": "4" }
              ]
            }
          }
        },
        {
          "name": "Get service by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "services", "{{serviceId}}"] }
          }
        },
        {
          "name": "Get service with bad id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/services/not-a-uuid", "host": ["{{baseUrl}}"], "path": ["api", "services", "not-a-uuid"] },
            "description": "Returns 400 with a validation error rather than a database failure."
          }
        },
        {
          "name": "My services (TECHNICIAN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{technicianToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/technician/services", "host": ["{{baseUrl}}"], "path": ["api", "technician", "services"] }
          }
        },
        {
          "name": "Add service (TECHNICIAN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/services", "host": ["{{baseUrl}}"], "path": ["api", "technician", "services"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Water heater installation\",\n  \"description\": \"Supply and fit an electric water heater.\",\n  \"price\": 210,\n  \"categoryId\": \"{{categoryId}}\"\n}"
            }
          }
        },
        {
          "name": "Add service with negative price (rejected)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/services", "host": ["{{baseUrl}}"], "path": ["api", "technician", "services"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Free work\",\n  \"price\": -50,\n  \"categoryId\": \"{{categoryId}}\"\n}"
            },
            "description": "Returns 400."
          }
        },
        {
          "name": "Update service (TECHNICIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "technician", "services", "{{serviceId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 135\n}"
            }
          }
        },
        {
          "name": "Delete service (TECHNICIAN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{technicianToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/technician/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "technician", "services", "{{serviceId}}"] },
            "description": "Refuses with 409 while bookings against this service are still in flight."
          }
        }
      ]
    },
    {
      "name": "Technicians",
      "item": [
        {
          "name": "List technicians",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/technicians?location=Dhaka&maxHourlyRate=60",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technicians"],
              "query": [
                { "key": "location", "value": "Dhaka" },
                { "key": "maxHourlyRate", "value": "60" }
              ]
            }
          }
        },
        {
          "name": "Get technician profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/technicians/{{technicianId}}", "host": ["{{baseUrl}}"], "path": ["api", "technicians", "{{technicianId}}"] }
          }
        },
        {
          "name": "Update profile (TECHNICIAN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/profile", "host": ["{{baseUrl}}"], "path": ["api", "technician", "profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Licensed plumber, 10 years of residential work.\",\n  \"skills\": [\"Pipe fitting\", \"Leak detection\"],\n  \"experienceYears\": 10,\n  \"hourlyRate\": 45,\n  \"location\": \"Dhanmondi, Dhaka\"\n}"
            }
          }
        },
        {
          "name": "Update availability (TECHNICIAN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/availability", "host": ["{{baseUrl}}"], "path": ["api", "technician", "availability"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    { \"weekday\": \"SUNDAY\", \"startTime\": \"09:00\", \"endTime\": \"17:00\" },\n    { \"weekday\": \"MONDAY\", \"startTime\": \"09:00\", \"endTime\": \"17:00\" },\n    { \"weekday\": \"TUESDAY\", \"startTime\": \"09:00\", \"endTime\": \"13:00\" }\n  ]\n}"
            },
            "description": "Replaces the whole week in one transaction."
          }
        },
        {
          "name": "Update availability with end before start (rejected)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/availability", "host": ["{{baseUrl}}"], "path": ["api", "technician", "availability"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    { \"weekday\": \"MONDAY\", \"startTime\": \"17:00\", \"endTime\": \"09:00\" }\n  ]\n}"
            },
            "description": "Returns 400."
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create booking (CUSTOMER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('bookingId', pm.response.json().data.booking.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"scheduledAt\": \"2026-09-15T10:00:00.000Z\",\n  \"address\": \"House 24, Road 7, Dhanmondi, Dhaka\",\n  \"notes\": \"Please call before arriving.\"\n}"
            }
          }
        },
        {
          "name": "Create booking with missing address (rejected)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"scheduledAt\": \"2026-09-15T10:00:00.000Z\"\n}"
            },
            "description": "Returns 400 listing the failing field."
          }
        },
        {
          "name": "Create booking as technician (rejected)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"scheduledAt\": \"2026-09-20T10:00:00.000Z\",\n  \"address\": \"Anywhere\"\n}"
            },
            "description": "Returns 403 — booking is customer-only."
          }
        },
        {
          "name": "My bookings (CUSTOMER)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "My bookings filtered by status (CUSTOMER)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/bookings?status=COMPLETED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"],
              "query": [{ "key": "status", "value": "COMPLETED" }]
            }
          }
        },
        {
          "name": "Get booking by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Cancel booking (CUSTOMER)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}", "cancel"] }
          }
        },
        {
          "name": "Incoming bookings (TECHNICIAN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{technicianToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/technician/bookings", "host": ["{{baseUrl}}"], "path": ["api", "technician", "bookings"] }
          }
        },
        {
          "name": "Accept booking (TECHNICIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "technician", "bookings", "{{bookingId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACCEPTED\"\n}" }
          }
        },
        {
          "name": "Decline booking (TECHNICIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "technician", "bookings", "{{bookingId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"DECLINED\"\n}" }
          }
        },
        {
          "name": "Start job (TECHNICIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "technician", "bookings", "{{bookingId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}" },
            "description": "Only allowed once the booking is PAID."
          }
        },
        {
          "name": "Complete job (TECHNICIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/technician/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "technician", "bookings", "{{bookingId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"COMPLETED\"\n}" }
          }
        },
        {
          "name": "All bookings (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/bookings", "host": ["{{baseUrl}}"], "path": ["api", "admin", "bookings"] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create checkout session (CUSTOMER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    console.log('Open this URL to pay:', pm.response.json().data.checkoutUrl);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/create", "host": ["{{baseUrl}}"], "path": ["api", "payments", "create"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\"\n}"
            },
            "description": "Only works while the booking is ACCEPTED. Test card: 4242 4242 4242 4242, any future expiry, any CVC."
          }
        },
        {
          "name": "My payments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const payments = pm.response.json().data.payments;",
                  "if (payments && payments.length) {",
                  "    pm.collectionVariables.set('paymentId', payments[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/payments", "host": ["{{baseUrl}}"], "path": ["api", "payments"] }
          }
        },
        {
          "name": "Get payment by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["api", "payments", "{{paymentId}}"] }
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create review (CUSTOMER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api", "reviews"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"rating\": 5,\n  \"comment\": \"Fast, tidy and explained the fix clearly.\"\n}"
            },
            "description": "Requires a COMPLETED booking. A second review for the same booking returns 409."
          }
        },
        {
          "name": "Create review with rating 9 (rejected)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api", "reviews"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"rating\": 9\n}"
            },
            "description": "Returns 400 — rating must be 1-5."
          }
        },
        {
          "name": "Get technician reviews",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reviews/technician/{{technicianId}}", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "technician", "{{technicianId}}"] }
          }
        }
      ]
    },
    {
      "name": "Misc",
      "item": [
        {
          "name": "Platform stats (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/stats", "host": ["{{baseUrl}}"], "path": ["api", "admin", "stats"] }
          }
        },
        {
          "name": "Unknown route",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/does-not-exist", "host": ["{{baseUrl}}"], "path": ["api", "does-not-exist"] },
            "description": "Returns a structured 404."
          }
        }
      ]
    }
  ]
}
