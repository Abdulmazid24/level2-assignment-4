enum Role {
    OWNER
    ADMIN
    RENTER
}

model User {
    id        String    @id @default(uuid())
    name      String
    email     String    @unique
    password  String
    role      Role      @default(RENTER)
    cars      Car[]     @relation("UserCars")
    bookings  Booking[] @relation("UserBookings")
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
}